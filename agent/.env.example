# Chalk Model Gateway (LLM policy + judge).
# HackHarvard: use the key from the Chalk #api-key channel with Chalk's router env.
CHALK_ROUTER_API_KEY=
CHALK_ROUTER_ENV_ID=clkdcdaf84e
# Our own environment (sandboxes, evaluations)
CHALK_ENV_ID=mtlk337e9659
# CHALK_ROUTER_URL=https://api.chalk.ai/v1/router
# SENTINEL_MODEL=openai/gpt-6.1-sol
# SENTINEL_JUDGE_MODEL=openai/gpt-6.1-sol

# Signs outgoing webhooks (receivers verify X-Sentinel-Signature)
SENTINEL_WEBHOOK_SECRET=change-me

# Optional SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# Email alerts: default recipient (the inbox your personal agent, e.g. Muse, watches)
SENTINEL_ALERT_EMAIL=
# Sending account. Gmail: SMTP_USER=you@gmail.com and an app password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_USER=
SMTP_PASSWORD=

# Bearer token personal agents (e.g. Muse) use to connect to the MCP endpoint
SENTINEL_MCP_TOKEN=

# Default location for `python -m sentinel demo` (lat/lon avoid a lookup during the demo)
SENTINEL_DEMO_ADDRESS=
SENTINEL_DEMO_LAT=
SENTINEL_DEMO_LON=

# Photon (spectrum-ts via photon-bridge/). Setting PHOTON_PROJECT_ID turns the Photon channel on.
# PHOTON_PROJECT_ID=
# PHOTON_PROJECT_SECRET=
# PHOTON_WEBHOOK_SECRET=any-long-random-string   # signs bridge -> app inbound requests
# PHOTON_BRIDGE_SECRET=another-long-random-string # app -> bridge auth
# PHOTON_BRIDGE_URL=http://127.0.0.1:3001
# PHOTON_NUMBER=+1...                             # optional: shown in texts if you have a dedicated line
# SENTINEL_REMINDER_MIN=10
# SENTINEL_MAX_REMINDERS=6

# Routes use OpenStreetMap roads + the satellite fire model (no key needed).
# SENTINEL_ROUTE_MAX_AGE_MIN=5

# SENTINEL_PUBLIC_URL=http://localhost:8080
# SENTINEL_TZ=America/Los_Angeles
# SENTINEL_WEB_HOST=127.0.0.1

# Phone the replay demo texts (python -m sentinel demo --send)
# DEMO_PHONE=+1...

# Outbound phone calls over Photon Voice (python -m sentinel call, or "Call my phone" on /test). See docs/VOICE_SETUP.md.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=      # the Photon number imported into ElevenLabs via SIP trunk
# SENTINEL_CALLS=1                 # phone subscribers on alerts (the demo uses --call instead)
# SENTINEL_CALL_ON=evacuate        # text kinds that also call: warn,evacuate
