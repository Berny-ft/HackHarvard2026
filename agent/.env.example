# Chalk Model Gateway (LLM policy + judge).
# HackHarvard: use the key from the Chalk #api-key channel with Chalk's router env.
CHALK_ROUTER_API_KEY=
CHALK_ROUTER_ENV_ID=clkdcdaf84e
# Our own environment (sandboxes, evaluations)
CHALK_ENV_ID=mtlk337e9659
# CHALK_ROUTER_URL=https://api.chalk.ai/v1/router
# SENTINEL_MODEL=openai/gpt-6.1-sol
# SENTINEL_JUDGE_MODEL=openai/gpt-6.1-sol

# Signs outgoing webhooks (receivers verify X-Sentinel-Signature)
SENTINEL_WEBHOOK_SECRET=change-me

# Optional SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# Email alerts: default recipient (the inbox your personal agent, e.g. Muse, watches)
SENTINEL_ALERT_EMAIL=
# Sending account. Gmail: SMTP_USER=you@gmail.com and an app password
# (Google Account -> Security -> 2-Step Verification -> App passwords)
SMTP_USER=
SMTP_PASSWORD=

# Bearer token personal agents (e.g. Muse) use to connect to the MCP endpoint
SENTINEL_MCP_TOKEN=

# Default location for `python -m sentinel demo` (lat/lon avoid a lookup during the demo)
SENTINEL_DEMO_ADDRESS=
SENTINEL_DEMO_LAT=
SENTINEL_DEMO_LON=
